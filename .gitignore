*.sublime-workspace

# Logs
*.log
logs/*.log

# Files with problematic filenames (too long for git on Windows)
*Anna's Archive.pdf

# Large binary files
*.exe
*.dll

# Library PDFs (large files - track separately or use Git LFS)
library/

# Per-project research source documents (same class as library/ above: large
# third-party PDFs/ebooks). These are SOURCE MATERIAL, not project work —
# they live on disk + Drive, never in git. Added 2026-07-25 after a 3.9 GB
# push failure traced to 199 committed PDFs. Our OWN rendered exhibits
# (_research/exhibits/, _research/genealogy/) are small and stay tracked.
video-projects/**/_research/documents/
research/example articles/
*.epub

# EXTENDED 2026-07-27. The exhibits/ folder above was exempted on the premise
# that it holds only OUR OWN small renders. On #55 Falklands it accumulated
# 96 MB of third-party source material instead — a 58 MB FO memorandum scan,
# an 8.5 MB book scan, and ~14 MB of full-book OCR extracts. That is the same
# class as documents/ and library/, so the same rule applies: source material
# lives on disk + Drive, never in git. Small artefacts we produced ourselves
# (page renders, short OCR of hard-to-reobtain items) stay tracked.
video-projects/**/_research/exhibits/*.pdf
video-projects/**/_research/exhibits/*-CLEANED.txt
video-projects/**/_research/exhibits/*-FULLTEXT.txt
video-projects/**/_research/exhibits/wtest-*.txt
video-projects/**/_research/exhibits/Wellington-Despatches-*.txt

# Files rescued out of git history before the 2026-07-25 history rewrite
# (research PDFs/audio from deleted projects that existed ONLY in git).
# Move these to Drive; never re-commit them.
_rescued-from-git/

# YouTube Analytics credentials (belt and suspenders)
# NOTE: module dir uses an UNDERSCORE (youtube_analytics). The old hyphen paths
# here were dead rules — fixed 2026-06-03. Patterns broadened to catch a stray
# token/secret export anywhere, backed by the pre-commit secret-guard hook.
tools/youtube_analytics/credentials/
**/client_secret*.json
**/*oauth*.json
**/token.json
**/*-token.json
**/*_token.json
**/service-account*.json
*.pem
*.key
*.p12
*.pfx

# Scratch/temporary files in youtube_analytics (backfill artifacts)
tools/youtube_analytics/_longform_*.json
tools/youtube_analytics/_backfill_ids.txt

# Database migration backups (auto-generated, not source)
tools/discovery/backups/

# Playwright MCP runtime cache
.playwright-mcp/

# Stray temp/debug files at repo root
_tmp_*.txt
# Leading slash = repo root ONLY. This catches a stray analytics.db written by a
# tool run from the wrong cwd. It does NOT ignore the real database.
# The three SQLite DBs are deliberately TRACKED — they are how this repo syncs
# state between machines, so expect them dirty after any tool run and stage them
# with the work that wrote them:
#   tools/youtube_analytics/analytics.db · tools/discovery/keywords.db · tools/intel/intel.db
/analytics.db

# Empty stderr dumps from flight-deals scanner
flight-deals/scans/*.err
flight-deals/scans/*.stderr.log

# Reconcile recovery backups (deleted after /reconcile --undo)
*.pre-diff

# graphify research-pipeline intermediates (regenerated by tools/refresh-research-graph.py)
graphify-out/research/.analysis.json
graphify-out/research/.graphify_extract.json
graphify-out/research/.labels.json

# graphify pipeline intermediates/cache under video projects (regenerated)
video-projects/graphify-out/
video-projects/**/graphify-out/

# graphify pipeline intermediates/cache at repo root + .claude (regenerated, ~750MB)
/graphify-out/
.claude/graphify-out/

# Session scratch / temp (SERP sheets, thumbnail previews, etc.)
/tmp/

# Independent migration/milestone snapshots. These are recovery artifacts, not
# active memory and not Git history.
/_migration-snapshots/

# SQLite WAL/SHM journal files (transient)
*.db-wal
*.db-shm

# Transient per-run routine logs (diagnostics, not knowledge)
.brain/_inbox/*.log

# pytest cache (regenerated locally, never committed)
.pytest_cache/
