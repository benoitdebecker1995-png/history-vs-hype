{
  "description": "Minimum conversational hooks: protect locked assets, keep channel state separate from the active video, report data freshness, and capture ordinary-language state changes. Windows paths are absolute because Codex does not interpolate the project variable.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/tools/hooks/locked_asset_guard.py\"",
            "commandWindows": "python \"G:\\History vs Hype\\tools\\hooks\\locked_asset_guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking for protected assets"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/tools/hooks/session_context.py\"",
            "commandWindows": "python \"G:\\History vs Hype\\tools\\hooks\\session_context.py\"",
            "timeout": 30,
            "additionalContextLimit": 5000,
            "statusMessage": "Loading the channel and current video"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/tools/hooks/utterance_triggers.py\"",
            "commandWindows": "python \"G:\\History vs Hype\\tools\\hooks\\utterance_triggers.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
